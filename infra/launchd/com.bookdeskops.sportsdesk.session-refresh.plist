<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  F402 session auto-refresh LaunchAgent (template).

  Supervises `scripts/f402_session_refresh.ts` on a 5-minute interval so the 21-minute server
  bearer cannot silently kill the bridge. The script is idempotent: when the session is fresh
  it is a no-op and the exit code is 0; it only spawns `session_login.ts` with the from-keychain
  flag (the TTL is a cap; a bearer session's file expiry is the JWT `exp` minus 2 minutes) when
  the current session is missing, expired, or within 5 min of expiring. XML comments may not
  contain a double hyphen, so flag names are spelled out here.

  Runs Bun directly with the no-env-file flag: credentials come from the login keychain
  (from-keychain), not from `.env.op`/`op`. This keeps the refresher independent of the
  service-account token and the 1Password Desktop `.env` FIFO. The watchdog template is likewise
  keychain-only.

  Substitute these placeholders before loading (see `scripts/install_session_refresh_agent.sh`):
    __OPERATOR_HOME__  absolute path to $HOME on the target machine
    __REPO_PATH__      absolute path to the sportsdesk-ops working copy
    __BUN_BIN__        absolute path to `bun` (`$(which bun)`)
    __BUN_BIN_DIR__    directory containing `__BUN_BIN__` (`$(dirname "$(which bun)")`)

  This file deliberately does not ship a prefilled plist: the operator home and the repo path
  are machine-specific, and `~/Library/LaunchAgents/` writes require the plist to live outside
  the repo. The installer copies-with-substitution into the user LaunchAgent directory.
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.bookdeskops.sportsdesk.session-refresh</string>

    <key>ProgramArguments</key>
    <array>
      <string>__BUN_BIN__</string>
      <string>--no-orphans</string>
      <string>--no-env-file</string>
      <string>run</string>
      <string>scripts/f402_session_refresh.ts</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_PATH__</string>

    <key>EnvironmentVariables</key>
    <dict>
      <key>HOME</key>
      <string>__OPERATOR_HOME__</string>
      <!-- Bun is invoked by absolute path; Homebrew stays on PATH for the keychain helper. -->
      <key>PATH</key>
      <string>__BUN_BIN_DIR__:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
      <key>NO_PROXY</key>
      <string>127.0.0.1,localhost,::1</string>
      <!--
        Session store. "file" keeps ~/.cache/sportsdesk/f402-session.json (0600). "keychain" keeps
        the session in the login Keychain via Bun.secrets (service com.bookdeskops.sportsdesk,
        entry f402-session) and writes no session file. Only switch to "keychain" once every
        process that reads the session loads it with `await loadF402Session()` (see
        docs/runbooks/f402_session_refresh.md), and set the same value for those processes.
      -->
      <key>F402_SESSION_STORE</key>
      <string>file</string>
    </dict>

    <!-- Fire every 5 minutes. StartInterval is wall-clock seconds, not elapsed. -->
    <key>StartInterval</key>
    <integer>300</integer>

    <!-- Also run once immediately after `launchctl load` so the first tick is not 5 min away. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Rate-limit retries if `op run` or upstream auth fails. -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!--
      KeepAlive would be wrong here: this is a one-shot per tick, not a long-running daemon.
      StartInterval + RunAtLoad is the correct supervision shape for an idempotent cron script.
    -->

    <!--
      Logs land in scratch/ next to the other cron journals; the script writes JSONL there too
      (`scratch/f402-session-refresh.jsonl`). The stdout/stderr files below exist only to catch
      an unhandled throw from the runner itself, which should never print anything sensitive.
    -->
    <key>StandardOutPath</key>
    <string>__REPO_PATH__/scratch/f402-session-refresh.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO_PATH__/scratch/f402-session-refresh.stderr.log</string>

    <!-- Nice level: slightly background; a 5-min keychain read is not interactive. -->
    <key>Nice</key>
    <integer>5</integer>

    <!-- Don't keep the process pool populated; this is a short-lived refresher. -->
    <key>ProcessType</key>
    <string>Background</string>
  </dict>
</plist>
