# Bun lockfiles. The text rule is declared first by policy; the binary rule must keep the
# `binary` attribute and name `diff=lockb` after it. Order is enforced by
# scripts/verify_ci_gates.ts (`gitattributes/order`).
bun.lock text eol=lf linguist-generated=true
*.lockb binary diff=lockb linguist-generated=true

# Image assets are binary: no textual diff/merge. The extension list is derived from
# `IMAGE_ASSET_EXTENSIONS` (lib/bun_image_assets.ts) and enforced by
# tests/assets_git_metadata.test.ts; add a format there and here together.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.gif binary
*.bmp binary
*.tif binary
*.tiff binary
*.heic binary

# Thumbnails and their manifest are generated by `bun run assets:diagnostics --thumbs`.
**/.thumbs/** linguist-generated=true
